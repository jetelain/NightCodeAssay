<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nightcodeassay</ToolCommandName>
    <PackageId>NightCodeForge.Assay</PackageId>
    <Description>Lightweight zero-VRAM exploratory testing companion for NightCodeForge and standalone QA sessions</Description>
    <Authors>Pmad</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jetelain/NightCodeAssay</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jetelain/NightCodeAssay</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightCodeAssay.Core\NightCodeAssay.Core.csproj" />
    <ProjectReference Include="..\NightCodeAssay.Infrastructure\NightCodeAssay.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NightCodeAssay.Tests" />
  </ItemGroup>

  <Target Name="PruneUnsupportedRuntimes"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_PrunedRuntimeFiles Include="@(ResolvedFileToPublish)"
                           Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').ToLowerInvariant().StartsWith('runtimes/'))
                                      AND (
                                        $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').ToLowerInvariant().EndsWith('.pdb'))
                                        OR (
                                          !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').ToLowerInvariant().StartsWith('runtimes/win/'))
                                          AND !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').ToLowerInvariant().StartsWith('runtimes/win-x64/'))
                                          AND !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').ToLowerInvariant().StartsWith('runtimes/win-arm64/'))
                                          AND !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').ToLowerInvariant().StartsWith('runtimes/linux-x64/'))
                                          AND !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').ToLowerInvariant().StartsWith('runtimes/linux-arm64/'))
                                          AND !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').ToLowerInvariant().StartsWith('runtimes/osx/'))
                                        )
                                      )" />
      <ResolvedFileToPublish Remove="@(_PrunedRuntimeFiles)" />
    </ItemGroup>
  </Target>

</Project>
